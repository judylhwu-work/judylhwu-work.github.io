#!/usr/bin/env bash
#
# Auto-encrypt the NDA case studies before each commit, so you never run a
# command by hand and plaintext never reaches the repo. Sources live in the
# git-ignored private/ folder; only the encrypted output is committed.
set -euo pipefail
ROOT="$(git rev-parse --show-toplevel)"

# nothing to do if the private sources aren't present (e.g. a fresh clone)
if [ ! -d "$ROOT/private/projects" ]; then
  exit 0
fi

bash "$ROOT/scripts/encrypt.sh"

# Stage exactly the pages encrypt.sh just wrote. The slug list is read from
# encrypt.sh rather than repeated here: when nova-to-claude was merged away, a
# second copy of the list still named it and aborted every commit. Staging all of
# projects/ would avoid that too, but would sweep in edits to the public case
# studies, which this hook has no business touching.
SLUGS="$(sed -n 's/^SLUGS=(\(.*\))/\1/p' "$ROOT/scripts/encrypt.sh")"
git add "$ROOT/.staticrypt.json"
for slug in $SLUGS; do
  [ -f "$ROOT/projects/$slug/index.html" ] && git add "$ROOT/projects/$slug/index.html"
done
